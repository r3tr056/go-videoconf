# Copy to .env and fill in real values. Never commit .env with real secrets.
# Used by docker compose (see docker-compose.yml) and local runs.

# REQUIRED. HS256 signing secret for the users service. Must be long and
# random, e.g. from: openssl rand -base64 48
# Both the server and docker compose fail fast when this is missing.
JWT_SECRET=change-me-to-a-long-random-secret

# Optional overrides (defaults shown).
JWT_ISSUER=VideoConf
DB_HOST=mongodb
DB_PORT=27017
DB_NAME=vidchat
DB_USERNAME=root
DB_PASSWORD=rootpassword

# Comma-separated origins allowed for CORS + WebSocket upgrades, e.g.
# WS_ALLOWED_ORIGINS=https://meet.example.com. Empty (default) allows all
# origins for local development; set this in production.
WS_ALLOWED_ORIGINS=

# Bundled TURN server (coturn). TURN_USER/TURN_PASSWORD authenticate relay
# allocations; TURN_PUBLIC_URL is the URL browsers use (reachable from client
# networks — override for LAN/WAN deployments).
TURN_USER=videoconf
TURN_PASSWORD=change-me-to-a-long-random-secret
TURN_REALM=videoconf
TURN_PUBLIC_URL=turn:localhost:3478
# TURN_EXTERNAL_IP=203.0.113.10  # WAN: coturn's public IP (see DEPLOYMENT.md)
